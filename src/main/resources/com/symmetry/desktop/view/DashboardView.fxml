<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.symmetry.desktop.controller.DashboardController"
      styleClass="contenido-vista" spacing="0">

    <ScrollPane fitToWidth="true" styleClass="scroll-fondo" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="18">
                <children>

                    <HBox styleClass="dash-hero" alignment="CENTER_LEFT" spacing="16">
                        <children>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="etiquetaSaludo" styleClass="titulo-principal"
                                           text="Tu resumen de hoy"/>
                                    <Label fx:id="etiquetaFecha" styleClass="subtitulo"/>
                                </children>
                            </VBox>
                            <Label fx:id="etiquetaEstadoDia" styleClass="dash-hero-badge"/>
                        </children>
                    </HBox>

                    <!-- ============ Frase de poder ============ -->
                    <HBox styleClass="tarjeta-frase" spacing="14" alignment="CENTER_LEFT">
                        <children>
                            <Label text="&#8220;" styleClass="frase-comillas"/>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label fx:id="etiquetaFrase" styleClass="frase-texto" wrapText="true"/>
                                    <Label fx:id="etiquetaAutorFrase" styleClass="frase-autor"/>
                                </children>
                            </VBox>
                            <Button text="&#8635;" styleClass="boton-icono" onAction="#otraFrase">
                                <tooltip>
                                    <Tooltip text="Mostrar otra frase"/>
                                </tooltip>
                            </Button>
                        </children>
                    </HBox>

                    <!-- ============ Panel RPG: nivel, XP y metas del dia ============ -->
                    <HBox styleClass="rpg-panel" spacing="24" alignment="CENTER_LEFT">
                        <children>
                            <HBox spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                <children>
                                    <StackPane styleClass="rpg-medalla" minWidth="80" minHeight="80"
                                               maxWidth="80" maxHeight="80">
                                        <children>
                                            <Label fx:id="etiquetaNivelNumero" styleClass="rpg-medalla-numero"/>
                                        </children>
                                    </StackPane>
                                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label fx:id="etiquetaNivelTitulo" styleClass="rpg-titulo"/>
                                            <ProgressBar fx:id="barraXp" styleClass="barra-xp, barra-xp-grande"
                                                         maxWidth="Infinity" progress="0"/>
                                            <Label fx:id="etiquetaXp" styleClass="texto-secundario"/>
                                            <Label fx:id="etiquetaXpResumen" styleClass="texto-secundario"/>
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                            <VBox spacing="2" minWidth="300" prefWidth="320">
                                <children>
                                    <Label text="Metas del día · XP" styleClass="rpg-subtitulo-meta"/>
                                    <VBox fx:id="listaMetas" spacing="0"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <!-- ============ Retos flash (12 h) y diarios (24 h) ============ -->
                    <VBox spacing="4">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <children>
                                    <Label text="Retos flash y diarios" styleClass="titulo-seccion"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="etiquetaRetosEstado" styleClass="texto-secundario"/>
                                </children>
                            </HBox>
                            <Label text="Se generan según tu historial: priorizan el músculo y el nivel que más atención necesitan. Los flash se renuevan cada 12 h y los diarios cada 24 h."
                                   styleClass="texto-secundario" wrapText="true"/>
                        </children>
                    </VBox>

                    <FlowPane fx:id="rejillaRetos" hgap="14" vgap="14" prefWrapLength="1000"/>

                    <GridPane hgap="14" vgap="14">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <children>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <children>
                                    <Label text="Rutina de hoy" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorRutina" styleClass="valor-acento" wrapText="true"/>
                                    <Label fx:id="detalleRutina" styleClass="texto-secundario" wrapText="true"/>
                                </children>
                            </VBox>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <children>
                                    <Label text="Proteína" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorProteina" styleClass="valor-metrica"/>
                                    <ProgressBar fx:id="barraProteina" maxWidth="Infinity" progress="0"/>
                                    <Label fx:id="detalleProteina" styleClass="texto-secundario"/>
                                </children>
                            </VBox>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <children>
                                    <Label text="Calorías" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorCalorias" styleClass="valor-metrica"/>
                                    <ProgressBar fx:id="barraCalorias" maxWidth="Infinity" progress="0"/>
                                    <Label fx:id="detalleCalorias" styleClass="texto-secundario"/>
                                </children>
                            </VBox>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                <children>
                                    <Label text="Hidratación" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorHidratacion" styleClass="valor-metrica"/>
                                    <ProgressBar fx:id="barraHidratacion" maxWidth="Infinity" progress="0"/>
                                    <Label fx:id="detalleHidratacion" styleClass="texto-secundario"/>
                                </children>
                            </VBox>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                <children>
                                    <Label text="Creatina" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorCreatina" styleClass="valor-metrica"/>
                                    <ProgressBar fx:id="barraCreatina" maxWidth="Infinity" progress="0"/>
                                    <Label fx:id="detalleCreatina" styleClass="texto-secundario"/>
                                </children>
                            </VBox>

                            <VBox styleClass="tarjeta-metrica" spacing="6" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                <children>
                                    <Label text="Descanso" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorSueno" styleClass="valor-metrica"/>
                                    <ProgressBar fx:id="barraSueno" maxWidth="Infinity" progress="0"/>
                                    <Label fx:id="detalleSueno" styleClass="texto-secundario"/>
                                </children>
                            </VBox>

                        </children>
                    </GridPane>

                    <VBox spacing="4">
                        <children>
                            <Label text="Recomendaciones basadas en evidencia" styleClass="titulo-seccion"/>
                            <Label text="Consejos accionables sobre sobrecarga progresiva, descanso, hidratación y esfuerzo. Toca una tarjeta para ver el detalle."
                                   styleClass="texto-secundario" wrapText="true"/>
                        </children>
                    </VBox>

                    <FlowPane fx:id="rejillaConsejos" hgap="14" vgap="14" prefWrapLength="1000"/>

                </children>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
