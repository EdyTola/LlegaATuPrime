<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.symmetry.desktop.controller.FormularioComidaController" spacing="12">
    <padding>
        <Insets top="8" right="14" bottom="8" left="14"/>
    </padding>
    <children>
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints minWidth="140" prefWidth="140"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="280"/>
            </columnConstraints>
            <children>
                <Label text="Nombre de la comida" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="campoNombre" promptText="Ej. Pechuga de pollo con arroz"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Proteína (g)" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="campoProteina" promptText="Ej. 40" maxWidth="140"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Calorías (kcal)" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="campoCalorias" promptText="Ej. 550" maxWidth="140"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Notas" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextArea fx:id="campoNotas" prefRowCount="3" wrapText="true"
                          promptText="Detalles de la comida (opcional)"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </children>
        </GridPane>
        <Label fx:id="etiquetaError" styleClass="texto-error" wrapText="true"/>
    </children>
</VBox>
