<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.symmetry.desktop.controller.WorkoutPlayerController"
            styleClass="raiz">

    <top>
        <HBox styleClass="cabecera" alignment="CENTER_LEFT" spacing="14">
            <padding>
                <Insets top="14" right="20" bottom="14" left="20"/>
            </padding>
            <children>
                <VBox spacing="2">
                    <Label text="Workout Player" styleClass="titulo-seccion"/>
                    <Label fx:id="etiquetaRutina" styleClass="texto-secundario"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Tiempo de sesión" styleClass="etiqueta-metrica"/>
                    <Label fx:id="cronometro" text="00:00:00" styleClass="cronometro"/>
                </VBox>
                <Button fx:id="botonCronometro" text="Pausar" styleClass="boton-secundario"
                        onAction="#alternarCronometro"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox styleClass="nav-lateral" prefWidth="270" spacing="8">
            <padding>
                <Insets top="16" right="12" bottom="16" left="12"/>
            </padding>
            <children>
                <Label text="Ejercicios de la sesión" styleClass="titulo-seccion"/>
                <ListView fx:id="listaEjercicios" VBox.vgrow="ALWAYS"/>
                <Label fx:id="etiquetaProgreso" styleClass="texto-secundario" wrapText="true"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="12" styleClass="contenido-vista">
            <children>

                <VBox styleClass="tarjeta" spacing="8">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <children>
                                <VBox spacing="3">
                                    <Label fx:id="etiquetaEjercicio" styleClass="titulo-seccion"
                                           text="Selecciona un ejercicio"/>
                                    <Label fx:id="etiquetaPrescripcion" styleClass="texto-secundario"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="etiquetaRir" styleClass="valor-acento"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <TableView fx:id="tablaSeries" VBox.vgrow="ALWAYS"/>

                <VBox styleClass="tarjeta" spacing="10">
                    <children>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Descanso entre series" styleClass="titulo-seccion"/>
                                <Spinner fx:id="spinnerDescanso" editable="true" prefWidth="110"/>
                                <Button fx:id="botonDescanso" text="Iniciar descanso" styleClass="boton-acento"
                                        onAction="#iniciarDescanso"/>
                                <Button text="+15 s" styleClass="boton-secundario"
                                        onAction="#agregarQuinceSegundos"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="etiquetaDescanso" text="90 s" styleClass="etiqueta-descanso"/>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox spacing="8" alignment="CENTER_LEFT">
                    <children>
                        <Button fx:id="botonMaquinaOcupada" text="Máquina ocupada" styleClass="boton-secundario"
                                onAction="#maquinaOcupada"/>
                        <Button fx:id="botonVerTecnica" text="Ver técnica" styleClass="boton-secundario"
                                onAction="#verTecnica"/>
                        <Button fx:id="botonAdjuntar" text="Adjuntar multimedia" styleClass="boton-secundario"
                                onAction="#adjuntarMultimedia"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="etiquetaVolumen" styleClass="texto-secundario"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">
            <padding>
                <Insets top="12" right="20" bottom="16" left="20"/>
            </padding>
            <children>
                <Label fx:id="etiquetaEstado" styleClass="texto-secundario"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="botonCancelar" text="Descartar sesión" styleClass="boton-peligro"
                        onAction="#cancelar"/>
                <Button fx:id="botonFinalizar" text="Finalizar y guardar" styleClass="boton-primario"
                        onAction="#finalizar"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>
