<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.symmetry.desktop.controller.ProgresoController"
      styleClass="contenido-vista" spacing="0">

    <ScrollPane fitToWidth="true" styleClass="scroll-fondo" VBox.vgrow="ALWAYS">
        <content>
            <VBox spacing="16">
                <children>

                    <!--
                        Barra de filtros: cada selector tiene un ancho minimo igual a su ancho
                        preferido para que ni las etiquetas ("Periodo", "Metrica", "Ejercicio")
                        ni los valores se recorten. El selector de ejercicio absorbe el espacio
                        sobrante (hgrow ALWAYS), evitando que el resto se comprima.
                    -->
                    <HBox styleClass="toolbar-vista" spacing="10" alignment="CENTER_LEFT">
                        <children>
                            <Label text="Periodo" styleClass="titulo-seccion" minWidth="56"/>
                            <ComboBox fx:id="selectorRango" onAction="#cambiarFiltro"
                                      prefWidth="150" minWidth="150" maxWidth="150"/>
                            <Label text="Métrica" styleClass="titulo-seccion" minWidth="56"/>
                            <ComboBox fx:id="selectorMetrica" onAction="#cambiarMetrica"
                                      prefWidth="200" minWidth="200" maxWidth="200"/>
                            <Label text="Ejercicio" styleClass="titulo-seccion" minWidth="66"/>
                            <ComboBox fx:id="selectorEjercicio" onAction="#cambiarFiltro"
                                      prefWidth="260" minWidth="200" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Region minWidth="10"/>
                            <Button fx:id="botonRegistrarMedicion" text="Registrar medición"
                                    styleClass="boton-acento" onAction="#registrarMedicion"/>
                            <Button fx:id="botonEliminarMedicion" text="Eliminar medición"
                                    styleClass="boton-peligro" onAction="#eliminarMedicion"/>
                        </children>
                    </HBox>

                    <HBox spacing="16">
                        <children>
                            <VBox styleClass="tarjeta-metrica" spacing="6" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Sesiones registradas" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorSesiones" text="0" styleClass="valor-metrica"/>
                                    <Label text="Entrenamientos completados en el periodo"
                                           styleClass="texto-secundario" wrapText="true"/>
                                </children>
                            </VBox>
                            <VBox styleClass="tarjeta-metrica" spacing="6" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Duración media" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorDuracionMedia" text="0 min" styleClass="valor-metrica"/>
                                    <Label text="Tiempo medio por sesión completada"
                                           styleClass="texto-secundario" wrapText="true"/>
                                </children>
                            </VBox>
                            <VBox styleClass="tarjeta-metrica" spacing="6" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Volumen total" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorVolumen" text="0 kg" styleClass="valor-metrica"/>
                                    <Label text="Carga acumulada (peso × repeticiones)"
                                           styleClass="texto-secundario" wrapText="true"/>
                                </children>
                            </VBox>
                            <VBox styleClass="tarjeta-metrica tarjeta-racha" spacing="6" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Racha de entrenamiento" styleClass="etiqueta-metrica"/>
                                    <Label fx:id="valorRacha" text="0 días" styleClass="valor-racha"/>
                                    <Label text="Días consecutivos entrenando sin fallar"
                                           styleClass="texto-secundario" wrapText="true"/>
                                </children>
                            </VBox>
                        </children>
                    </HBox>

                    <VBox styleClass="tarjeta" spacing="10">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <Label fx:id="etiquetaGrafico" text="Evolución" styleClass="titulo-seccion"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="etiquetaPuntos" styleClass="texto-secundario"/>
                                </children>
                            </HBox>
                            <LineChart fx:id="grafico" prefHeight="340" animated="false"
                                       legendVisible="false" createSymbols="true">
                                <xAxis>
                                    <CategoryAxis fx:id="ejeX"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="ejeY"/>
                                </yAxis>
                            </LineChart>
                        </children>
                    </VBox>

                    <VBox styleClass="tarjeta" spacing="10">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Distribución de volumen por grupo muscular"
                                           styleClass="titulo-seccion"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="etiquetaGrupos" styleClass="texto-secundario"/>
                                </children>
                            </HBox>
                            <Label text="Carga levantada (peso × repeticiones) repartida por grupo muscular en el periodo seleccionado."
                                   styleClass="texto-secundario" wrapText="true"/>
                            <PieChart fx:id="graficoGrupos" prefHeight="320" animated="false"
                                      legendVisible="true" labelsVisible="false"/>
                        </children>
                    </VBox>

                    <VBox styleClass="tarjeta" spacing="12">
                        <children>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Galería de transformación" styleClass="titulo-seccion"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="botonAgregarFoto" text="Añadir foto"
                                            styleClass="boton-acento" onAction="#agregarFotoProgreso"/>
                                </children>
                            </HBox>
                            <Label text="Adjunta fotos de tu evolución física indicando la fecha y el tipo de pose (frente, espalda o perfil) para comparar mes a mes."
                                   styleClass="texto-secundario" wrapText="true"/>
                            <FlowPane fx:id="galeriaFotos" hgap="12" vgap="12" prefWrapLength="900"/>
                        </children>
                    </VBox>

                    <VBox styleClass="tarjeta" spacing="12">
                        <children>
                            <Label text="Historial de mediciones corporales" styleClass="titulo-seccion"/>
                            <Label text="Registra tu peso, cintura, grasa corporal y masa muscular para seguir la evolución corporal."
                                   styleClass="texto-secundario" wrapText="true"/>
                            <TableView fx:id="tablaMediciones" prefHeight="240"/>
                        </children>
                    </VBox>

                </children>
            </VBox>
        </content>
    </ScrollPane>
</VBox>
