<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Modulo 3 - Nutricion, hidratacion y descanso.
  Las tarjetas superiores (hidratacion / comidas) y las inferiores (creatina / descanso)
  comparten la misma rejilla de anchos para que los separadores queden alineados.
  Las alturas de la tabla de comidas y de la lista de hidratacion se calculan en el
  controlador segun el numero de registros (sin filas vacias estaticas).
  La raiz es un StackPane para poder superponer la capa de confeti de las celebraciones.
-->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="raizNutricion"
           fx:controller="com.symmetry.desktop.controller.NutricionController"
           styleClass="contenido-vista">

    <children>
        <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity">

            <ScrollPane fitToWidth="true" styleClass="scroll-fondo" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="16">
                        <children>

                            <HBox styleClass="toolbar-vista" spacing="12" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Fecha" styleClass="titulo-seccion"/>
                                    <DatePicker fx:id="selectorFecha" onAction="#cambiarFecha"/>
                                    <Button text="Hoy" styleClass="boton-secundario" onAction="#irAHoy"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="etiquetaResumenDia" styleClass="texto-secundario"/>
                                </children>
                            </HBox>

                            <!-- ================= Resumen del día =================
                                 Las tarjetas de indicadores se construyen en el controlador y se
                                 añaden a "rejillaResumen" (iconos vectoriales con llenado animado). -->
                            <VBox styleClass="tarjeta" spacing="14">
                                <children>
                                    <Label text="Resumen del día" styleClass="titulo-seccion"/>
                                    <HBox fx:id="rejillaResumen" spacing="12" fillHeight="true"
                                          alignment="TOP_CENTER"/>
                                </children>
                            </VBox>

                            <!-- ================= Hidratación rápida + Registro de comidas ================= -->
                            <HBox spacing="16" alignment="TOP_LEFT">
                                <children>

                                    <VBox styleClass="tarjeta" spacing="12" prefWidth="390" minWidth="340"
                                          maxHeight="Infinity">
                                        <children>
                                            <Label text="Hidratación rápida" styleClass="titulo-seccion"/>
                                            <Label text="Toca el envase que acabas de consumir."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <GridPane fx:id="contenedorEnvases" hgap="8" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                                </columnConstraints>
                                            </GridPane>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <TextField fx:id="campoCantidadPersonalizada" promptText="Otros ml"
                                                               prefWidth="120"/>
                                                    <Button text="Registrar" styleClass="boton-acento"
                                                            onAction="#registrarCantidadPersonalizada"/>
                                                </children>
                                            </HBox>
                                            <Region minHeight="4"/>
                                            <Label text="Registros de hoy" styleClass="subtitulo"/>
                                            <ListView fx:id="listaHidratacion"/>
                                        </children>
                                    </VBox>

                                    <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                                        <children>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <children>
                                                    <Label text="Registro de comidas" styleClass="titulo-seccion"/>
                                                    <Region HBox.hgrow="ALWAYS"/>
                                                    <Button fx:id="botonAgregarComida" text="Añadir comida"
                                                            styleClass="boton-acento" onAction="#agregarComida"/>
                                                </children>
                                            </HBox>
                                            <TableView fx:id="tablaComidas"/>
                                        </children>
                                    </VBox>

                                </children>
                            </HBox>

                            <!-- ================= Creatina + Descanso nocturno ================= -->
                            <HBox spacing="16" alignment="TOP_LEFT">
                                <children>

                                    <VBox styleClass="tarjeta" spacing="12" prefWidth="390" minWidth="340"
                                          maxHeight="Infinity">
                                        <children>
                                            <Label text="Creatina monohidrato" styleClass="titulo-seccion"/>
                                            <Label text="Toma diaria recomendada de 3 a 5 g."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <CheckBox fx:id="checkCreatina" text="Dosis de 5 g tomada hoy"
                                                      onAction="#alternarCreatina"/>
                                            <Label fx:id="detalleCreatina" styleClass="texto-secundario"
                                                   wrapText="true"/>
                                        </children>
                                    </VBox>

                                    <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                                        <children>
                                            <Label text="Descanso nocturno" styleClass="titulo-seccion"/>
                                            <Label text="Registra las horas dormidas para ajustar tu recuperación."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <Spinner fx:id="spinnerSueno" editable="true" prefWidth="120"/>
                                                    <Button text="Registrar horas" styleClass="boton-primario"
                                                            onAction="#registrarSueno"/>
                                                </children>
                                            </HBox>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <Label text="Rápido:" styleClass="texto-secundario"/>
                                                    <Button text="6 h" userData="6" styleClass="boton-chip"
                                                            onAction="#registrarSuenoRapido"/>
                                                    <Button text="7 h" userData="7" styleClass="boton-chip"
                                                            onAction="#registrarSuenoRapido"/>
                                                    <Button text="8 h" userData="8" styleClass="boton-chip"
                                                            onAction="#registrarSuenoRapido"/>
                                                    <Button text="9 h" userData="9" styleClass="boton-chip"
                                                            onAction="#registrarSuenoRapido"/>
                                                </children>
                                            </HBox>
                                            <Label fx:id="detalleSueno" styleClass="texto-secundario" wrapText="true"/>
                                        </children>
                                    </VBox>

                                </children>
                            </HBox>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>

        <!-- Capa transparente a los clics donde se dibuja el confeti de las celebraciones. -->
        <Pane fx:id="capaConfeti" mouseTransparent="true"/>
    </children>
</StackPane>
