<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.symmetry.desktop.controller.FormularioEjercicioController" spacing="12">
    <padding>
        <Insets top="8" right="14" bottom="8" left="14"/>
    </padding>
    <children>
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="300"/>
            </columnConstraints>
            <children>
                <Label text="Nombre del ejercicio" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="campoNombre" promptText="Ej. Jalón al pecho agarre medio"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Grupo muscular" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <ComboBox fx:id="comboGrupo" maxWidth="Infinity"
                          GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Series" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Spinner fx:id="spinnerSeries" editable="true" maxWidth="120"
                         GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Repeticiones mínimas" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Spinner fx:id="spinnerRepsMin" editable="true" maxWidth="120"
                         GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Repeticiones máximas" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Spinner fx:id="spinnerRepsMax" editable="true" maxWidth="120"
                         GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="RIR objetivo" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <Spinner fx:id="spinnerRir" editable="true" maxWidth="120"
                         GridPane.columnIndex="1" GridPane.rowIndex="5"/>

                <Label text="Descanso entre series (s)" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <Spinner fx:id="spinnerDescanso" editable="true" maxWidth="120"
                         GridPane.columnIndex="1" GridPane.rowIndex="6"/>

                <Label text="Prescripción por tiempo" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <CheckBox fx:id="checkPorTiempo" text="Las repeticiones se miden en segundos"
                          GridPane.columnIndex="1" GridPane.rowIndex="7"/>

                <Label text="Multimedia de técnica" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <HBox spacing="8" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="8">
                    <children>
                        <Label fx:id="etiquetaMultimedia" text="Sin archivo" styleClass="texto-secundario"/>
                        <Region HBox.hgrow="ALWAYS" minWidth="12"/>
                        <Button fx:id="botonSeleccionarMultimedia" text="Seleccionar..." styleClass="boton-secundario"
                                onAction="#seleccionarMultimedia"/>
                        <Button fx:id="botonQuitarMultimedia" text="Quitar" styleClass="boton-secundario"
                                onAction="#quitarMultimedia"/>
                    </children>
                </HBox>

                <Label text="Enlace o referencia" GridPane.columnIndex="0" GridPane.rowIndex="9"/>
                <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="9">
                    <children>
                        <TextField fx:id="campoEnlace"
                                   promptText="https://www.youtube.com/watch?v=...  (o ruta de referencia)"/>
                        <Label text="Se abre con el navegador o visor al pulsar «Ver técnica»."
                               styleClass="texto-secundario" wrapText="true"/>
                    </children>
                </VBox>

                <Label text="Notas" GridPane.columnIndex="0" GridPane.rowIndex="10"/>
                <TextArea fx:id="campoNotas" prefRowCount="3" wrapText="true"
                          promptText="Indicaciones de ejecución (opcional)"
                          GridPane.columnIndex="1" GridPane.rowIndex="10"/>
            </children>
        </GridPane>
        <Label fx:id="etiquetaError" styleClass="texto-error" wrapText="true"/>
    </children>
</VBox>
