<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.bey.desktop.controller.beyMainController"
            styleClass="raiz">

    <left>
        <VBox fx:id="beyMenuLateral" styleClass="nav-lateral" prefWidth="250">
            <children>
                <HBox styleClass="nav-marca" spacing="12" alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="22" right="18" bottom="16" left="18"/>
                    </padding>
                    <children>

                        <StackPane fx:id="beyLogoMarca" minWidth="44" minHeight="44"
                                   maxWidth="44" maxHeight="44"/>
                        <VBox spacing="2">
                            <children>
                                <HBox alignment="BASELINE_LEFT" spacing="5">
                                    <children>
                                        <Label text="Llega a tu" styleClass="nav-marca-titulo"/>
                                        <Label text="Prime" styleClass="nav-marca-acento"/>
                                    </children>
                                </HBox>
                                <Label text="Rendimiento · Salud" styleClass="nav-marca-subtitulo"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <VBox styleClass="nav-items" spacing="4" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="4" right="12" bottom="12" left="12"/>
                    </padding>
                    <children>
                        <ToggleButton fx:id="beyBotonInicio" styleClass="nav-boton" text="Inicio"
                                      maxWidth="Infinity" selected="true" contentDisplay="LEFT"
                                      onAction="#beyMostrarInicio">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M3 10.5L12 3l9 7.5 M5 9.5V20a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9.5 M9.5 21v-6.5h5V21"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="beyBotonEntrenamiento" styleClass="nav-boton" text="Entrenamiento"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyMostrarEntrenamiento">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M6.5 6.5v11 M17.5 6.5v11 M3.5 9v6 M20.5 9v6 M6.5 12h11"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="beyBotonNutricion" styleClass="nav-boton" text="Nutricion e hidratacion"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyMostrarNutricion">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7z"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="beyBotonMusica" styleClass="nav-boton" text="Musica local"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyMostrarMusica">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M9 18V5l12-2v13 M9 18a3 3 0 1 1-6 0 3 3 0 0 1 6 0z M21 16a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="beyBotonProgreso" styleClass="nav-boton" text="Progreso y analiticas"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyMostrarProgreso">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M3 3v18h18 M7 15l4-4 3 3 5-6"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <ToggleButton fx:id="beyBotonPerfil" styleClass="nav-boton" text="Mi perfil"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyMostrarPerfil">
                            <graphic>
                                <StackPane minWidth="22" prefWidth="22" maxWidth="22" minHeight="22" prefHeight="22" maxHeight="22">
                                    <children>
                                        <SVGPath styleClass="nav-icono-svg" scaleX="0.8" scaleY="0.8"
                                                 content="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2 M15.5 7a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0z"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                    </children>
                </VBox>

                <VBox styleClass="nav-pie" spacing="10">
                    <padding>
                        <Insets top="12" right="16" bottom="16" left="16"/>
                    </padding>
                    <children>

                        <VBox fx:id="beyTarjetaNivelNav" styleClass="nav-nivel" spacing="6" onMouseClicked="#beyMostrarInicio">
                            <children>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="beyEtiquetaNivelNav" styleClass="nav-nivel-insignia"/>
                                        <Label fx:id="beyEtiquetaTituloNav" styleClass="nav-nivel-titulo" HBox.hgrow="ALWAYS"/>
                                    </children>
                                </HBox>
                                <ProgressBar fx:id="beyBarraXpNav" styleClass="barra-xp" maxWidth="Infinity" progress="0"/>
                                <Label fx:id="beyEtiquetaXpNav" styleClass="nav-pie-texto"/>
                            </children>
                        </VBox>
                        <ToggleButton fx:id="beyBotonTema" styleClass="nav-tema" text="Modo oscuro"
                                      maxWidth="Infinity" contentDisplay="LEFT" onAction="#beyAlternarTema">
                            <graphic>
                                <StackPane styleClass="interruptor">
                                    <children>
                                        <Region styleClass="interruptor-bola"/>
                                    </children>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                        <VBox spacing="3">
                            <children>
                                <Label text="100% offline - datos locales" styleClass="nav-pie-texto"/>
                                <Label fx:id="beyEtiquetaRutaDatos" styleClass="nav-pie-texto" wrapText="true"/>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <BorderPane styleClass="area-contenido">
            <top>
                <HBox styleClass="cabecera" alignment="CENTER_LEFT" spacing="12">
                    <padding>
                        <Insets top="18" right="26" bottom="18" left="26"/>
                    </padding>
                    <children>
                        <Label fx:id="beyEtiquetaTituloSeccion" text="Inicio" styleClass="cabecera-titulo"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="beyEtiquetaFechaCabecera" styleClass="cabecera-fecha"/>
                    </children>
                </HBox>
            </top>
            <center>
                <StackPane>
                    <children>
                        <StackPane fx:id="beyContenedorVistas" styleClass="contenedor-vistas"/>

                        <StackPane fx:id="beyCapaCelebracion" pickOnBounds="false">
                            <children>
                                <Pane fx:id="beyCapaConfeti" mouseTransparent="true"/>
                                <VBox fx:id="beyContenedorToasts" spacing="8" alignment="BOTTOM_RIGHT"
                                      mouseTransparent="true" maxWidth="-Infinity" maxHeight="-Infinity"
                                      StackPane.alignment="BOTTOM_RIGHT">
                                    <padding>
                                        <Insets top="0" right="22" bottom="22" left="0"/>
                                    </padding>
                                </VBox>
                            </children>
                        </StackPane>
                    </children>
                </StackPane>
            </center>
        </BorderPane>
    </center>

    <bottom>
        <fx:include source="beyMiniReproductorView.fxml"/>
    </bottom>

</BorderPane>
