<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:id="beyRaizNutricion"
           fx:controller="com.bey.desktop.controller.beyNutricionController"
           styleClass="contenido-vista">

    <children>
        <VBox spacing="0" maxWidth="Infinity" maxHeight="Infinity">

            <ScrollPane fitToWidth="true" styleClass="scroll-fondo" VBox.vgrow="ALWAYS">
                <content>
                    <VBox spacing="16">
                        <children>

                            <HBox styleClass="toolbar-vista" spacing="12" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="Fecha" styleClass="titulo-seccion"/>
                                    <DatePicker fx:id="beySelectorFecha" onAction="#beyCambiarFecha"/>
                                    <Button text="Hoy" styleClass="boton-secundario" onAction="#beyIrAHoy"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="beyEtiquetaResumenDia" styleClass="texto-secundario"/>
                                </children>
                            </HBox>

                            <VBox styleClass="tarjeta" spacing="14">
                                <children>
                                    <Label text="Resumen del día" styleClass="titulo-seccion"/>
                                    <HBox fx:id="beyRejillaResumen" spacing="12" fillHeight="true"
                                          alignment="TOP_CENTER"/>
                                </children>
                            </VBox>

                            <HBox spacing="16" alignment="TOP_LEFT">
                                <children>

                                    <VBox styleClass="tarjeta" spacing="12" prefWidth="390" minWidth="340"
                                          maxHeight="Infinity">
                                        <children>
                                            <Label text="Hidratación rápida" styleClass="titulo-seccion"/>
                                            <Label text="Toca el envase que acabas de consumir."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <GridPane fx:id="beyContenedorEnvases" hgap="8" vgap="8">
                                                <columnConstraints>
                                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                                </columnConstraints>
                                            </GridPane>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <TextField fx:id="beyCampoCantidadPersonalizada" promptText="Otros ml"
                                                               prefWidth="120"/>
                                                    <Button text="Registrar" styleClass="boton-acento"
                                                            onAction="#beyRegistrarCantidadPersonalizada"/>
                                                </children>
                                            </HBox>
                                            <Region minHeight="4"/>
                                            <Label text="Registros de hoy" styleClass="subtitulo"/>
                                            <ListView fx:id="beyListaHidratacion"/>
                                        </children>
                                    </VBox>

                                    <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                                        <children>
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <children>
                                                    <Label text="Registro de comidas" styleClass="titulo-seccion"/>
                                                    <Region HBox.hgrow="ALWAYS"/>
                                                    <Button fx:id="botonAgregarComida" text="Añadir comida"
                                                            styleClass="boton-acento" onAction="#beyAgregarComida"/>
                                                </children>
                                            </HBox>
                                            <TableView fx:id="beyTablaComidas"/>
                                        </children>
                                    </VBox>

                                </children>
                            </HBox>

                            <HBox spacing="16" alignment="TOP_LEFT">
                                <children>

                                    <VBox styleClass="tarjeta" spacing="12" prefWidth="390" minWidth="340"
                                          maxHeight="Infinity">
                                        <children>
                                            <Label text="Creatina monohidrato" styleClass="titulo-seccion"/>
                                            <Label text="Toma diaria recomendada de 3 a 5 g."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <CheckBox fx:id="beyCheckCreatina" text="Dosis de 5 g tomada hoy"
                                                      onAction="#beyAlternarCreatina"/>
                                            <Label fx:id="beyDetalleCreatina" styleClass="texto-secundario"
                                                   wrapText="true"/>
                                        </children>
                                    </VBox>

                                    <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS" maxHeight="Infinity">
                                        <children>
                                            <Label text="Descanso nocturno" styleClass="titulo-seccion"/>
                                            <Label text="Registra las horas dormidas para ajustar tu recuperación."
                                                   styleClass="texto-secundario" wrapText="true"/>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <Spinner fx:id="beySpinnerSueno" editable="true" prefWidth="120"/>
                                                    <Button text="Registrar horas" styleClass="boton-primario"
                                                            onAction="#beyRegistrarSueno"/>
                                                </children>
                                            </HBox>
                                            <HBox spacing="8" alignment="CENTER_LEFT">
                                                <children>
                                                    <Label text="Rápido:" styleClass="texto-secundario"/>
                                                    <Button text="6 h" userData="6" styleClass="boton-chip"
                                                            onAction="#beyRegistrarSuenoRapido"/>
                                                    <Button text="7 h" userData="7" styleClass="boton-chip"
                                                            onAction="#beyRegistrarSuenoRapido"/>
                                                    <Button text="8 h" userData="8" styleClass="boton-chip"
                                                            onAction="#beyRegistrarSuenoRapido"/>
                                                    <Button text="9 h" userData="9" styleClass="boton-chip"
                                                            onAction="#beyRegistrarSuenoRapido"/>
                                                </children>
                                            </HBox>
                                            <Label fx:id="beyDetalleSueno" styleClass="texto-secundario" wrapText="true"/>
                                        </children>
                                    </VBox>

                                </children>
                            </HBox>

                        </children>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>

        <Pane fx:id="beyCapaConfeti" mouseTransparent="true"/>
    </children>
</StackPane>
